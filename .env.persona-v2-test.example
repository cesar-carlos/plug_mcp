# Copiar para /etc/se7e/persona-v2-test.env no destino, proprietário executor e modo 0600.
# Valores obrigatórios: preencher no servidor, nunca no repositório/chat.
PERSONA_V2_TEST_DATABASE_URL=
PERSONA_V2_TEST_ENCRYPTION_KEY=
PERSONA_V2_TEST_ENCRYPTION_KEY_ID=
PERSONA_V2_TEST_PUBLIC_URL=
PERSONA_V2_TEST_HUB_URL=
PERSONA_V2_TEST_LOCAL_PORT=
# Imagem é fornecida pelo deploy como ID verificado, não por tag neste arquivo.
PERSONA_V2_TEST_PREVIOUS_KEYS={}
PERSONA_V2_TEST_TRUST_PROXY=
PERSONA_V2_TEST_REDIS_URL=
PERSONA_V2_TEST_CACHE_TTL_MS=0
PERSONA_V2_TEST_OAUTH_ENABLED=false
PERSONA_V2_TEST_OAUTH_CLIENTS={}
