PORT=3333
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
PUBLIC_BASE_URL=http://127.0.0.1:3333

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/se7e_mcp

# AES-256-GCM (32 bytes hex = 64 chars) para senha do Client e client_token
MCP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

PLUG_SERVER_BASE_URL=https://plug-server.example.com
# Piso HTTP (login/refresh/getPolicy). Máx. 60000 (Zod). sql.execute usa o wait do bridge da skill (até 360s).
PLUG_SERVER_HTTP_TIMEOUT_MS=35000
PLUG_SERVER_TIMINGS_SAMPLE_PERCENT=10

QUERY_DEFAULT_MAX_ROWS=500
QUERY_ABSOLUTE_MAX_ROWS=5000
MCP_SESSION_IDLE_TIMEOUT_MS=1800000
AUDIT_LOG_RETENTION_DAYS=90
MCP_RATE_LIMIT_WINDOW_MS=60000
MCP_RATE_LIMIT_MAX=120
MCP_BOOTSTRAP_RATE_LIMIT_MAX=20
MCP_TOOL_RATE_LIMIT_MAX=60
MCP_QUERY_TOOL_RATE_LIMIT_MAX=20
MCP_TOKEN_TTL_DAYS=0
REDIS_URL=

MCP_ALLOWED_ORIGINS=
MCP_SKILL_TOOLS_ENABLED=false
# Tools novas (default true). false/0/no desliga para rollback.
MCP_INSPECTION_ENABLED=true
MCP_DISCOVERY_QUERY_ENABLED=true
MCP_SEMANTIC_QUERY_ENABLED=true
MCP_SCHEMA_DRIFT_ENABLED=true
QUERY_CACHE_TTL_MS=60000
# Coalescência de leituras agregadas iguais. Redis opcional coordena réplicas;
# em falha continua localmente sem bloquear uma consulta autorizada.
QUERY_CACHE_SINGLEFLIGHT_WAIT_MS=35000
QUERY_CACHE_SINGLEFLIGHT_LEASE_MS=300000

# Worker separado: npm run worker:operacoes (requer DATABASE_URL).
# Alertas nunca carregam SQL, pergunta, params, resultado ou segredo.
OPERATIONS_WORKER_INTERVAL_MS=60000
OPERATIONS_SLO_WINDOW_MINUTES=15
OPERATIONS_SLO_MIN_OBSERVATIONS=20
OPERATIONS_SLO_ERROR_WARNING_PERCENT=5
OPERATIONS_SLO_ERROR_CRITICAL_PERCENT=20
OPERATIONS_SLO_P95_WARNING_MS=10000
OPERATIONS_SLO_P95_CRITICAL_MS=30000
OPERATIONS_SLO_TRUNCATION_WARNING_PERCENT=10
OPERATIONS_WEBHOOK_TIMEOUT_MS=8000
OPERATIONS_WEBHOOK_LEASE_MS=305000

# SHA do commit (GET /health). Produção: GIT_SHA no PM2/Docker. Sem .git no container, passe ARG no build.
GIT_SHA=
