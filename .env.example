PORT=3333
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
PUBLIC_BASE_URL=http://127.0.0.1:3333

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/se7e_mcp

# HMAC/JWT da conta MCP (min 32 chars)
MCP_JWT_SECRET=change-me-mcp-jwt-secret-min-32-chars
MCP_JWT_ISSUER=se7e-mcp
MCP_JWT_ACCESS_TTL_SECONDS=900
MCP_JWT_REFRESH_TTL_SECONDS=1209600

# AES-256-GCM (32 bytes em hex = 64 chars) para client_token
MCP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Cookie de sessão do login OAuth
MCP_SESSION_SECRET=change-me-session-secret-min-32-chars

# Client de serviço no plug-server (não é o usuário final)
PLUG_SERVER_BASE_URL=https://plug-server.se7esistemassinop.com.br
PLUG_SERVER_CLIENT_EMAIL=
PLUG_SERVER_CLIENT_PASSWORD=
# Timeout HTTP do MCP contra o plug-server (rede de segurança; o timeout do SQL no agente é options.timeout_ms)
PLUG_SERVER_HTTP_TIMEOUT_MS=35000

# Apenas desenvolvimento: aceita este Bearer sem OAuth
MCP_DEV_BEARER_TOKEN=

# Default / teto de linhas em consultar_dados (o MCP monta a resposta inteira em memória;
# mantenha o teto absoluto conservador mesmo que o plug-server pagine)
QUERY_DEFAULT_MAX_ROWS=500
QUERY_ABSOLUTE_MAX_ROWS=5000

# Sessoes MCP (Streamable HTTP) ociosas por mais que isso sao encerradas e removidas da memoria
MCP_SESSION_IDLE_TIMEOUT_MS=1800000

# Rate limit de POST|GET|DELETE /mcp (por hash do Bearer ou IP). REDIS_URL vazio = memoria local.
MCP_RATE_LIMIT_WINDOW_MS=60000
MCP_RATE_LIMIT_MAX=120
REDIS_URL=

# Limpeza periódica de códigos/refresh OAuth expirados e retenção do audit_log
OAUTH_CLEANUP_INTERVAL_MS=3600000
AUDIT_LOG_RETENTION_DAYS=90
CONSULTA_MEMORIA_RETENTION_DAYS=365

# CORS: lista separada por virgulas de origins permitidas (ex.: https://chat.openai.com,https://claude.ai).
# Vazio = reflete o Origin da requisicao (necessario para clientes MCP web genericos).
MCP_ALLOWED_ORIGINS=

# Busca semântica opcional (pgvector). Vazio = FTS nativo do Postgres.
# Para ligar: instale a extension vector, rode drizzle/optional/0007_pgvector.sql
# e aponte EMBEDDING_API_URL para uma API compatível com OpenAI /embeddings.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---------------------------------------------------------------------------
# Testes "live" (tests/live/) contra o plug-server REAL (produção ou staging).
# Opcional: sem essas vars, os testes live se pulam sozinhos (describe.skipIf).
# Use SEMPRE uma conta de TESTE dedicada — nunca a conta de serviço principal
# (PLUG_SERVER_CLIENT_EMAIL/PASSWORD acima) nem credenciais de um Client real.
# Roda só via `npm run test:live`, nunca faz parte do `npm test` padrão.
# ---------------------------------------------------------------------------
E2E_AGENT_ID=
E2E_CLIENT_TOKEN=
E2E_CLIENT_EMAIL=
E2E_CLIENT_PASSWORD=
E2E_DIALETO=sybase
