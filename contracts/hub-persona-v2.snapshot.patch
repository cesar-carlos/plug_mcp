diff --git a/src/application/agent_commands/sql_operation_transport_guard.ts b/src/application/agent_commands/sql_operation_transport_guard.ts
new file mode 100644
index 0000000..3fc3403
--- /dev/null
+++ b/src/application/agent_commands/sql_operation_transport_guard.ts
@@ -0,0 +1,127 @@
+import { negotiateSqlOperations } from "../../shared/constants/sql_operation_transport";
+import { AppError } from "../../shared/errors/app_error";
+import { isRecord } from "../../shared/utils/rpc_types";
+import type { BridgeCommand } from "../../shared/validators/agent_command";
+
+export const hasSqlOperation = (command: BridgeCommand): boolean =>
+  (Array.isArray(command) ? command : [command]).some((item) =>
+    item.method.startsWith("sql.operation."),
+  );
+
+export const requiresLiveSqlCapability = (command: BridgeCommand): boolean =>
+  hasSqlOperation(command) ||
+  (Array.isArray(command) ? command : [command]).some(
+    (item) =>
+      item.method === "sql.describeSource" ||
+      item.method === "sql.describeSchema" ||
+      (isRecord(item.params) &&
+        "expectedSource" in item.params &&
+        item.params.expectedSource != null),
+  );
+
+/** Applies to the live authenticated agent registration, never consumer-provided metadata. */
+export const assertSqlOperationTransport = (
+  command: BridgeCommand,
+  capabilities: Record<string, unknown> | null,
+): void => {
+  const items = Array.isArray(command) ? command : [command];
+  const needsConstraints = items.some((item) => {
+    if (
+      !isRecord(item.params) ||
+      !("expectedStructure" in item.params) ||
+      !isRecord(item.params.expectedStructure)
+    )
+      return false;
+    const resources = item.params.expectedStructure.resources;
+    return (
+      Array.isArray(resources) &&
+      resources.some((r: unknown) => isRecord(r) && r.constraints !== undefined)
+    );
+  });
+  if (
+    needsConstraints &&
+    (!capabilities ||
+      !isRecord(capabilities.extensions) ||
+      capabilities.extensions.sourceConstraints !== 1)
+  )
+    throw new AppError("Agent has not negotiated sourceConstraints v1.", {
+      statusCode: 409,
+      code: "CAPABILITY_UNAVAILABLE",
+      details: { retryable: false },
+    });
+  if (
+    items.some(
+      (item) =>
+        item.method === "sql.describeSchema" ||
+        (isRecord(item.params) &&
+          "expectedStructure" in item.params &&
+          item.params.expectedStructure !== undefined),
+    ) &&
+    (!capabilities ||
+      !isRecord(capabilities.extensions) ||
+      capabilities.extensions.sourceSchema !== 1)
+  )
+    throw new AppError("Agent has not negotiated sourceSchema v1.", {
+      statusCode: 409,
+      code: "CAPABILITY_UNAVAILABLE",
+      details: { retryable: false },
+    });
+  if (
+    items.some((item) => item.method === "sql.describeSource") &&
+    (!capabilities ||
+      !isRecord(capabilities.extensions) ||
+      capabilities.extensions.sourceDiscovery !== 1)
+  )
+    throw new AppError("Agent has not negotiated source discovery v1.", {
+      statusCode: 409,
+      code: "CAPABILITY_UNAVAILABLE",
+      details: { retryable: false },
+    });
+  if (
+    items.some(
+      (item) =>
+        isRecord(item.params) &&
+        "expectedSource" in item.params &&
+        item.params.expectedSource != null,
+    ) &&
+    (!capabilities ||
+      !isRecord(capabilities.extensions) ||
+      capabilities.extensions.sourceIdentity !== 1)
+  ) {
+    throw new AppError("Agent has not negotiated executing-connection source identity v1.", {
+      statusCode: 409,
+      code: "CAPABILITY_UNAVAILABLE",
+      details: { retryable: false },
+    });
+  }
+  if (!hasSqlOperation(command)) return;
+  const extensions =
+    capabilities && isRecord(capabilities.extensions) ? capabilities.extensions : null;
+  const negotiated = negotiateSqlOperations(extensions?.sqlOperations);
+  if (!negotiated)
+    throw new AppError("Agent has not negotiated SQL operations version 1.", {
+      statusCode: 409,
+      code: "CAPABILITY_UNAVAILABLE",
+      details: { retryable: false, contractVersion: 1 },
+    });
+  for (const item of Array.isArray(command) ? command : [command]) {
+    if (item.method !== "sql.operation.execute") continue;
+    if (item.params.expectedStructure && negotiated.structureGuard !== 1)
+      throw new AppError("Agent has not negotiated sqlOperations.structureGuard v1.", {
+        statusCode: 409,
+        code: "CAPABILITY_UNAVAILABLE",
+        details: { retryable: false },
+      });
+    if (
+      item.params.steps.length > negotiated.maxSteps ||
+      item.params.maxAffectedRows > negotiated.maxAffectedRows ||
+      item.params.timeoutMs > negotiated.timeoutMs
+    ) {
+      throw new AppError("SQL operation exceeds negotiated limits.", {
+        statusCode: 409,
+        code: "SQL_OPERATION_NEGOTIATED_LIMIT",
+        details: { retryable: false },
+      });
+    }
+  }
+};
diff --git a/src/application/services/client_delegation.service.ts b/src/application/services/client_delegation.service.ts
new file mode 100644
index 0000000..b146d8b
--- /dev/null
+++ b/src/application/services/client_delegation.service.ts
@@ -0,0 +1,99 @@
+import { createHash, randomBytes, randomUUID } from "node:crypto";
+import type {
+  ClientAdministrativePermission,
+  IClientDelegationRepository,
+} from "../../domain/ports/client_delegation.port";
+import type { IClientRepository } from "../../domain/repositories/client.repository.interface";
+import { unauthorized, notFound } from "../../shared/errors/http_errors";
+
+export interface ClientDelegationProof {
+  id: string;
+  clientId: string;
+  audience: string;
+  personaId: string;
+  expiresAt: string;
+  administrative: readonly ClientAdministrativePermission[];
+}
+/** A delegation proves only an active Client; it cannot route agent commands or approve operations. */
+export class ClientDelegationService {
+  constructor(
+    private readonly repository: IClientDelegationRepository,
+    private readonly clients: IClientRepository,
+    private readonly now = () => new Date(),
+  ) {}
+  async create(
+    clientId: string,
+    input: {
+      audience: string;
+      personaId: string;
+      administrative?: readonly ClientAdministrativePermission[];
+    },
+  ): Promise<ClientDelegationProof & { credential: string }> {
+    const client = await this.clients.findActiveSnapshotById(clientId);
+    if (client?.status !== "active") throw unauthorized("Active Client required");
+    const credential = "pdv2_" + randomBytes(32).toString("base64url");
+    const value = {
+      id: randomUUID(),
+      clientId,
+      administrative: [
+        ...new Set<ClientAdministrativePermission>(input.administrative ?? ["gerenciar_fontes"]),
+      ],
+      audience: input.audience,
+      personaId: input.personaId,
+      tokenHash: createHash("sha256").update(credential).digest("hex"),
+      credentialsUpdatedAt: client.credentialsUpdatedAt,
+      expiresAt: new Date(this.now().getTime() + 30 * 86400000),
+      revokedAt: null,
+    };
+    await this.repository.create(value);
+    return {
+      id: value.id,
+      clientId,
+      audience: value.audience,
+      personaId: value.personaId,
+      expiresAt: value.expiresAt.toISOString(),
+      administrative: value.administrative,
+      credential,
+    };
+  }
+  async verify(
+    credential: string,
+    input: {
+      audience: string;
+      personaId: string;
+      administrative?: readonly ClientAdministrativePermission[];
+    },
+  ): Promise<ClientDelegationProof & { active: true }> {
+    if (!/^pdv2_[A-Za-z0-9_-]{43}$/.test(credential)) throw unauthorized("Invalid delegation");
+    const value = await this.repository.findByHash(
+      createHash("sha256").update(credential).digest("hex"),
+    );
+    if (
+      !value ||
+      value.revokedAt ||
+      value.expiresAt <= this.now() ||
+      value.audience !== input.audience ||
+      value.personaId !== input.personaId
+    )
+      throw unauthorized("Invalid delegation");
+    const client = await this.clients.findActiveSnapshotById(value.clientId);
+    if (
+      client?.status !== "active" ||
+      client.credentialsUpdatedAt.getTime() !== value.credentialsUpdatedAt.getTime()
+    )
+      throw unauthorized("Invalid delegation");
+    return {
+      id: value.id,
+      clientId: value.clientId,
+      audience: value.audience,
+      personaId: value.personaId,
+      expiresAt: value.expiresAt.toISOString(),
+      administrative: value.administrative,
+      active: true as const,
+    };
+  }
+  async revoke(clientId: string, id: string): Promise<void> {
+    if (!(await this.repository.revoke(id, clientId, this.now())))
+      throw notFound("Delegation unavailable");
+  }
+}
diff --git a/src/domain/ports/client_delegation.port.ts b/src/domain/ports/client_delegation.port.ts
new file mode 100644
index 0000000..286e623
--- /dev/null
+++ b/src/domain/ports/client_delegation.port.ts
@@ -0,0 +1,25 @@
+export const CLIENT_ADMINISTRATIVE_PERMISSIONS = [
+  "treinar",
+  "publicar",
+  "gerenciar_fontes",
+  "gerenciar_tokens",
+  "gerenciar_integracoes",
+] as const;
+export type ClientAdministrativePermission = (typeof CLIENT_ADMINISTRATIVE_PERMISSIONS)[number];
+
+export interface ClientDelegation {
+  readonly administrative: readonly ClientAdministrativePermission[];
+  readonly id: string;
+  readonly clientId: string;
+  readonly tokenHash: string;
+  readonly audience: string;
+  readonly personaId: string;
+  readonly credentialsUpdatedAt: Date;
+  readonly expiresAt: Date;
+  readonly revokedAt: Date | null;
+}
+export interface IClientDelegationRepository {
+  create(value: ClientDelegation): Promise<void>;
+  findByHash(hash: string): Promise<ClientDelegation | null>;
+  revoke(id: string, clientId: string, now: Date): Promise<boolean>;
+}
diff --git a/src/infrastructure/repositories/in_memory_client_delegation.repository.ts b/src/infrastructure/repositories/in_memory_client_delegation.repository.ts
new file mode 100644
index 0000000..276e08d
--- /dev/null
+++ b/src/infrastructure/repositories/in_memory_client_delegation.repository.ts
@@ -0,0 +1,19 @@
+import type {
+  ClientDelegation,
+  IClientDelegationRepository,
+} from "../../domain/ports/client_delegation.port";
+export class InMemoryClientDelegationRepository implements IClientDelegationRepository {
+  private readonly values = new Map<string, ClientDelegation>();
+  async create(value: ClientDelegation): Promise<void> {
+    this.values.set(value.tokenHash, structuredClone(value));
+  }
+  async findByHash(hash: string): Promise<ClientDelegation | null> {
+    return structuredClone(this.values.get(hash) ?? null);
+  }
+  async revoke(id: string, clientId: string, now: Date): Promise<boolean> {
+    const value = [...this.values.values()].find((v) => v.id === id && v.clientId === clientId);
+    if (!value) return false;
+    this.values.set(value.tokenHash, { ...value, revokedAt: value.revokedAt ?? now });
+    return true;
+  }
+}
diff --git a/src/infrastructure/repositories/prisma_client_delegation.repository.ts b/src/infrastructure/repositories/prisma_client_delegation.repository.ts
new file mode 100644
index 0000000..e9c4503
--- /dev/null
+++ b/src/infrastructure/repositories/prisma_client_delegation.repository.ts
@@ -0,0 +1,61 @@
+import type {
+  ClientDelegation,
+  IClientDelegationRepository,
+} from "../../domain/ports/client_delegation.port";
+import { randomUUID } from "node:crypto";
+import { prismaClient } from "../database/prisma/client";
+/** Parameterized SQL and metadata-only audit share the mutation transaction. */
+export class PrismaClientDelegationRepository implements IClientDelegationRepository {
+  async create(v: ClientDelegation): Promise<void> {
+    await prismaClient.$transaction(async (tx) => {
+      await tx.$executeRaw`INSERT INTO client_persona_delegations
+        (id,client_id,token_hash,audience,persona_id,credentials_updated_at,expires_at,administrative)
+        VALUES(${v.id},${v.clientId},${v.tokenHash},${v.audience},${v.personaId},
+        ${v.credentialsUpdatedAt},${v.expiresAt},${JSON.stringify(v.administrative)}::jsonb)`;
+      await tx.auditEvent.create({
+        data: {
+          id: randomUUID(),
+          eventType: "client.persona_delegation.created",
+          actorRole: "client",
+          payloadJson: {
+            clientId: v.clientId,
+            personaId: v.personaId,
+            delegationId: v.id,
+            expiresAt: v.expiresAt.toISOString(),
+            administrative: [...v.administrative],
+          },
+        },
+      });
+    });
+  }
+  async findByHash(hash: string): Promise<ClientDelegation | null> {
+    const rows = await prismaClient.$queryRaw<
+      ClientDelegation[]
+    >`SELECT id, client_id AS "clientId",
+      token_hash AS "tokenHash", audience, persona_id AS "personaId",
+      credentials_updated_at AS "credentialsUpdatedAt", expires_at AS "expiresAt",
+      administrative, revoked_at AS "revokedAt" FROM client_persona_delegations WHERE token_hash=${hash}`;
+    return rows[0] ?? null;
+  }
+  async revoke(id: string, clientId: string, now: Date): Promise<boolean> {
+    return prismaClient.$transaction(async (tx) => {
+      const changed = await tx.$queryRaw<{ personaId: string }[]>`UPDATE client_persona_delegations
+        SET revoked_at=${now} WHERE id=${id} AND client_id=${clientId} AND revoked_at IS NULL RETURNING persona_id AS "personaId"`;
+      if (changed[0]) {
+        await tx.auditEvent.create({
+          data: {
+            id: randomUUID(),
+            eventType: "client.persona_delegation.revoked",
+            actorRole: "client",
+            payloadJson: { clientId, personaId: changed[0].personaId, delegationId: id },
+          },
+        });
+        return true;
+      }
+      const existing = await tx.$queryRaw<
+        { id: string }[]
+      >`SELECT id FROM client_persona_delegations WHERE id=${id} AND client_id=${clientId}`;
+      return existing.length === 1;
+    });
+  }
+}
