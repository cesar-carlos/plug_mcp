ith identity, bindings and expiry; no credentials"}},"security":[],"summary":"Verify the opaque delegation and active Client without issuing a JWT","tags":["Client Auth"]}},"/client-auth/persona-delegations/{id}":{"delete":{"parameters":[{"in":"path","name":"id","required":true,"schema":{"format":"uuid","type":"string"}}],"responses":{"204":{"description":"Revoked"}},"security":[{"bearerAuth":[]}],"summary":"Revoke an owned delegation; revocation cannot be undone","tags":["Client Auth"]}},"/client-auth/refresh":{"post":{"description":"Rate-limited with `REST_TOKEN_REFRESH_RATE_LIMIT_*` (same as `/auth/refresh`), separate from the credential limiter used on `/client-auth/login`. Refresh token transport follows `RefreshTokenTransport`: JSON body and/or HttpOnly `client_refresh_token` cookie. When both are sent, **body > cookie** (non-empty body wins).\n","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RefreshTokenTransport"}}},"required":false},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ClientAuthResponse"}}},"description":"New access/refresh tokens issued"},"400":{"description":"Missing refresh token in body/cookie"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/TooManyRequests"}},"summary":"Refresh a client session token","tags":["Client Auth"]}},"/client/me/agent-access-requests":{"get":{"parameters":[{"in":"query","name":"status","schema":{"enum":["pending","approved","rejected","expired","revoked"],"type":"string"}},{"in":"query","name":"search","schema":{"maxLength":120,"type":"string"}},{"in":"query","name":"page","schema":{"minimum":1,"type":"integer"}},{"in":"query","name":"pageSize","schema":{"maximum":100,"minimum":1,"type":"integer"}}],"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"count":{"type":"integer"},"page":{"type":"integer"},"pageSize":{"type":"integer"},"requests":{"items":{"$ref":"#/componen