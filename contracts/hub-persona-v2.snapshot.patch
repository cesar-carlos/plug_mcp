pageSize"],"type":"object"}}},"description":"Approved agents with profile data"},"401":{"$ref":"#/components/responses/Unauthorized"}},"security":[{"bearerAuth":[]}],"summary":"List approved agents for the authenticated client","tags":["Client Agent Access"]},"post":{"description":"Validates each `agentId`. If approved access already exists (`ClientAgentAccess`), returns that id in `alreadyApproved` and does not email the owner. Otherwise creates or refreshes a `pending` `ClientAgentAccessRequest` (including after the client removed access with `DELETE /client/me/agents` while the prior request row was still `approved`), issues a new approval token, and emails the agent owner.\n","requestBody":{"content":{"application/json":{"schema":{"properties":{"agentIds":{"items":{"format":"uuid","type":"string"},"maxItems":100,"minItems":1,"type":"array"}},"required":["agentIds"],"type":"object"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"alreadyApproved":{"description":"Agent IDs that already had `ClientAgentAccess` for this client","items":{"format":"uuid","type":"string"},"type":"array"},"debounced":{"description":"Agent IDs skipped because a pending request was refreshed within the debounce window (no new email)","items":{"format":"uuid","type":"string"},"type":"array"},"newRequests":{"description":"Subset of `requested` with no prior `ClientAgentAccessRequest` row","items":{"format":"uuid","type":"string"},"type":"array"},"reopened":{"description":"Subset of `requested` that reopened an existing request row","items":{"format":"uuid","type":"string"},"type":"array"},"requested":{"description":"Agent IDs for which a pending request was saved and the owner was emailed in this call","items":{"format":"uuid","type":"string"},"type":"array"}},"required":["requested","alreadyApproved","newRequests","reopened","debounced"],"type":"object"}}},"description":"Access request processing result"},"401":{"$ref":"#/components/responses/