+    properties: {
+      operationId: { type: "string", format: "uuid" },
+      fingerprint: { type: "string", pattern: "^[a-f0-9]{64}$" },
+      executionId: { type: "string" },
+      state: {
+        type: "string",
+        enum: [
+          "executando",
+          "cancelamento_solicitado",
+          "concluida",
+          "rollback_confirmado",
+          "resultado_desconhecido",
