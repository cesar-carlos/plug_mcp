{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "se7e-package-v1"
    },
    "runtime": {
      "type": "string",
      "enum": ["legacy", "persona-v2"]
    },
    "variant": {
      "type": "string",
      "enum": ["chatgpt", "portable"]
    },
    "publicBaseUrl": {
      "type": "string",
      "format": "uri"
    },
    "resource": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$"
    },
    "connectionId": {
      "type": "string"
    },
    "toolCatalogHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "minItems": 1,
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["path", "sha256", "bytes"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "runtime",
    "variant",
    "publicBaseUrl",
    "resource",
    "version",
    "toolCatalogHash",
    "files"
  ],
  "additionalProperties": false
}
