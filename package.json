{
  "name": "se7e-mcp-server",
  "version": "0.2.0",
  "private": true,
  "description": "Servidor MCP Se7e: cofre de credenciais do Client e catálogo de skills isolado por acesso",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "web:build": "npm ci --prefix web --include=dev && npm run build --prefix web",
    "web:dev": "npm run dev --prefix web",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "worker:operacoes": "tsx --env-file-if-exists=.env src/worker-operacoes.ts",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "release:check": "npm run node:check && npm run compiler:check && npm run training:check && npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run web:check",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/infrastructure/persistence/migrate.ts",
    "test:migrations": "tsx scripts/verify-migrations.ts && tsx scripts/verify-oauth-postgres.ts --ci",
    "db:backfill-escopo": "tsx --env-file-if-exists=.env src/infrastructure/persistence/backfill-escopo.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "compiler:check": "node scripts/check-compiler.mjs",
    "runtime:check": "node scripts/smoke-runtime.mjs",
    "test:evaluation": "vitest run tests/evaluation",
    "evaluate:consumer": "tsx scripts/evaluate-consumer.ts",
    "vault:rotate": "tsx --env-file-if-exists=.env scripts/rotate-encryption.ts",
    "evaluate:skills": "tsx scripts/evaluate-skills.ts",
    "training:check": "tsx scripts/check-training-base.ts",
    "plugin:package": "tsx --env-file-if-exists=.env scripts/package-chatgpt-plugin.ts",
    "oauth:revoke": "tsx --env-file-if-exists=.env scripts/revoke-chatgpt-oauth.ts",
    "node:check": "node scripts/check-node-version.mjs",
    "test:chatgpt:https": "vitest run tests/integration/cimd-https.test.ts",
    "test:chatgpt:browser": "playwright test",
    "chatgpt:check": "tsx --env-file-if-exists=.env scripts/check-chatgpt-readiness.ts",
    "web:check": "npm run lint --prefix web && npm run typecheck --prefix web && npm run test --prefix web && npm run build --prefix web",
    "test:console:browser": "npm run build --prefix web && playwright test --config playwright.console.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "^2.3.0",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "node-sql-parser": "^5.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "redis": "^6.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.0",
    "@playwright/test": "^1.63.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
